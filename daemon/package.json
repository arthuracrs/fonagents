{
  "name": "@fonagents/daemon",
  "version": "0.0.0",
  "description": "Daemon process that wires all adapters together and runs the orchestrator.",
  "main": "./dist/cli.js",
  "bin": {
    "fonagents": "./dist/cli.js"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc && esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js --format=cjs --external:better-sqlite3 --external:bindings",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fonagents/core": "^0.0.0",
    "@fonagents/taskforge-adapter": "^0.0.0",
    "@fonagents/anagent-adapter": "^0.0.0",
    "@fonagents/http-sse-adapter": "^0.0.0",
    "better-sqlite3": "^11.0.0",
    "bindings": "^1.5.0",
    "express": "^5.2.1"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
